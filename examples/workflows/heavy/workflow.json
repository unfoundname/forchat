{
  "name": "heavy",
  "version": 1,
  "entry": "root",
  "limits": {
    "max_concurrent": 4,
    "max_depth": 3,
    "max_workers": 24,
    "max_wall_seconds": 259200,
    "max_total_tokens": 100000000,
    "max_total_hard_tokens": 0
  },
  "workers": {
    "root": {
      "role_file": "prompts/root.md",
      "can_spawn": ["recon", "spike", "architect", "contract_doctor", "coder", "reviewer", "ui_acceptance", "integrator", "fixer"],
      "tools": [
        "spawn", "wait_workers", "stop_worker", "inspect_worker",
        "write_contract", "read_contracts", "verify_contract",
        "propose_contract_change", "decide_contract_change", "check_contract_coverage",
        "write_note", "read_state",
        "write_artifact", "read_worker_report", "run_checks", "git", "report"
      ],
      "budget": {"tokens": 30000000, "wall_seconds": 259200},
      "require_checks": true,
      "require_coverage": true,
      "hooks": {"on_done": [{"action": "snapshot"}]}
    },
    "recon": {
      "role_file": "prompts/recon.md",
      "can_spawn": [],
      "tools": [
        "web_fetch", "web_search", "read", "page_screenshot", "page_text",
        "read_image", "image_diff", "write_artifact", "write_note", "report"
      ],
      "budget": {"tokens": 4000000, "wall_seconds": 7200}
    },
    "spike": {
      "role_file": "prompts/spike.md",
      "can_spawn": [],
      "tools": [
        "read", "grep", "glob", "edit_file", "write_file", "run_python",
        "git", "run_checks", "read_contracts", "page_screenshot", "page_text",
        "read_image", "image_diff", "write_note", "report"
      ],
      "budget": {"tokens": 8000000, "wall_seconds": 21600}
    },
    "architect": {
      "role_file": "prompts/architect.md",
      "can_spawn": [],
      "tools": [
        "read", "grep", "glob", "edit_file", "write_file", "run_python",
        "run_checks", "git", "read_contracts", "check_contract_coverage",
        "page_screenshot", "page_text", "read_image", "image_diff",
        "write_artifact", "report"
      ],
      "budget": {"tokens": 8000000, "wall_seconds": 21600}
    },
    "contract_doctor": {
      "role_file": "prompts/contract_doctor.md",
      "can_spawn": [],
      "tools": [
        "read", "grep", "read_contracts", "check_contract_coverage",
        "propose_contract_change", "write_artifact", "report"
      ],
      "budget": {"tokens": 4000000, "wall_seconds": 14400}
    },
    "coder": {
      "role_file": "prompts/coder.md",
      "can_spawn": [],
      "tools": [
        "read", "grep", "glob", "edit_file", "write_file", "run_python",
        "git", "run_checks", "read_contracts", "verify_contract",
        "check_contract_coverage", "propose_contract_change",
        "page_screenshot", "page_text", "read_image", "image_diff",
        "read_state", "write_note", "report"
      ],
      "budget": {"tokens": 10000000, "wall_seconds": 43200},
      "hooks": {
        "on_done": [{
          "spawn": "reviewer",
          "task": "审查 coder {worker_id} 的分支与工作区：读 diff、跑测试、核对契约漂移",
          "wait": false
        }]
      }
    },
    "reviewer": {
      "role_file": "prompts/reviewer.md",
      "can_spawn": [],
      "tools": [
        "read", "grep", "glob", "run_python", "run_checks", "git",
        "read_contracts", "verify_contract", "check_contract_coverage",
        "page_screenshot", "page_text", "read_image", "image_diff",
        "read_worker_report", "read_state", "write_artifact", "report"
      ],
      "budget": {"tokens": 3000000, "wall_seconds": 7200}
    },
    "ui_acceptance": {
      "role_file": "prompts/ui_acceptance.md",
      "can_spawn": ["visual_critic", "fixer"],
      "tools": [
        "spawn", "wait_workers", "inspect_worker", "read_worker_report",
        "read_image", "page_screenshot", "page_text", "image_diff",
        "read_contracts", "check_contract_coverage", "run_checks",
        "write_note", "write_artifact", "report"
      ],
      "budget": {"tokens": 8000000, "wall_seconds": 86400}
    },
    "visual_critic": {
      "role_file": "prompts/visual_critic.md",
      "can_spawn": [],
      "tools": [
        "read_image", "page_screenshot", "page_text", "image_diff",
        "read", "grep", "read_contracts", "check_contract_coverage",
        "read_worker_report", "write_artifact", "report"
      ],
      "budget": {"tokens": 4000000, "wall_seconds": 10800}
    },
    "integrator": {
      "role_file": "prompts/integrator.md",
      "can_spawn": [],
      "tools": ["read", "grep", "run_python", "run_checks", "git", "report"],
      "budget": {"tokens": 6000000, "wall_seconds": 21600}
    },
    "fixer": {
      "role_file": "prompts/fixer.md",
      "can_spawn": [],
      "tools": [
        "read", "grep", "glob", "edit_file", "write_file", "run_python",
        "run_checks", "git", "page_screenshot", "read_image", "image_diff",
        "read_state", "report"
      ],
      "budget": {"tokens": 6000000, "wall_seconds": 21600}
    }
  }
}
