{
  "name": "worktree",
  "version": 1,
  "entry": "root",
  "limits": {
    "max_concurrent": 3,
    "max_depth": 2,
    "max_workers": 8,
    "max_wall_seconds": 900
  },
  "workers": {
    "root": {
      "role_file": "prompts/root.md",
      "can_spawn": [
        "coder"
      ],
      "tools": [
        "spawn",
        "wait_workers",
        "report",
        "read_state",
        "write_note",
        "git",
        "read_worker_report"
      ],
      "budget": {
        "tokens": 30000,
        "wall_seconds": 600
      }
    },
    "coder": {
      "role_file": "prompts/coder.md",
      "can_spawn": [],
      "tools": [
        "git",
        "write_file",
        "read",
        "run_python",
        "report",
        "read_state"
      ],
      "budget": {
        "tokens": 40000,
        "wall_seconds": 600
      }
    }
  }
}
