{
  "name": "frontend",
  "version": 1,
  "entry": "root",
  "limits": {
    "max_concurrent": 2,
    "max_depth": 2,
    "max_workers": 12,
    "max_wall_seconds": 86400,
    "max_total_tokens": 40000000
  },
  "workers": {
    "root": {
      "role_file": "prompts/root.md",
      "can_spawn": ["recon", "architect", "ui_coder", "visual_critic", "fixer"],
      "tools": [
        "spawn", "wait_workers", "stop_worker", "inspect_worker",
        "write_contract", "read_contracts", "verify_contract",
        "propose_contract_change", "decide_contract_change", "check_contract_coverage",
        "write_note", "read_state", "write_artifact", "read_worker_report",
        "run_checks", "page_screenshot", "report"
      ],
      "budget": {"tokens": 15000000, "wall_seconds": 86400},
      "require_checks": true,
      "require_coverage": true,
      "hooks": {"on_done": [{"action": "snapshot"}]}
    },
    "recon": {
      "role_file": "prompts/recon.md",
      "can_spawn": [],
      "tools": [
        "page_screenshot", "page_text", "web_fetch", "web_search",
        "read_image", "image_diff", "write_artifact", "write_note", "report"
      ],
      "budget": {"tokens": 4000000, "wall_seconds": 7200}
    },
    "architect": {
      "role_file": "prompts/architect.md",
      "can_spawn": [],
      "tools": [
        "read", "grep", "glob", "edit_file", "write_file", "run_python",
        "git", "run_checks", "page_screenshot", "page_text", "read_contracts",
        "check_contract_coverage", "write_artifact", "report"
      ],
      "budget": {"tokens": 6000000, "wall_seconds": 21600}
    },
    "ui_coder": {
      "role_file": "prompts/ui_coder.md",
      "can_spawn": [],
      "tools": [
        "read", "grep", "glob", "edit_file", "write_file", "run_python",
        "git", "run_checks", "page_screenshot", "page_text", "read_image",
        "image_diff", "read_contracts", "verify_contract", "check_contract_coverage",
        "propose_contract_change", "read_state", "write_note", "report"
      ],
      "budget": {"tokens": 10000000, "wall_seconds": 43200}
    },
    "visual_critic": {
      "role_file": "prompts/visual_critic.md",
      "can_spawn": [],
      "tools": [
        "read_image", "page_screenshot", "page_text", "image_diff",
        "read", "grep", "read_contracts", "check_contract_coverage",
        "write_artifact", "report"
      ],
      "budget": {"tokens": 4000000, "wall_seconds": 10800}
    },
    "fixer": {
      "role_file": "prompts/fixer.md",
      "can_spawn": [],
      "tools": [
        "read", "grep", "glob", "edit_file", "write_file", "run_python",
        "git", "run_checks", "page_screenshot", "read_image", "image_diff",
        "read_contracts", "report"
      ],
      "budget": {"tokens": 6000000, "wall_seconds": 21600}
    }
  }
}
