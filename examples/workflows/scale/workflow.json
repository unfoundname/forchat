{
  "name": "scale",
  "version": 1,
  "entry": "root",
  "limits": {
    "max_concurrent": 4,
    "max_depth": 2,
    "max_workers": 12,
    "max_wall_seconds": 2400,
    "max_total_tokens": 10000000
  },
  "workers": {
    "root": {
      "role_file": "prompts/root.md",
      "can_spawn": [
        "coder"
      ],
      "tools": [
        "spawn",
        "wait_workers",
        "git",
        "run_python",
        "read",
        "read_state",
        "write_note",
        "read_worker_report",
        "report",
        "edit_file",
        "grep",
        "glob"
      ],
      "budget": {
        "tokens": 2000000,
        "wall_seconds": 1200
      }
    },
    "coder": {
      "role_file": "prompts/coder.md",
      "can_spawn": [],
      "tools": [
        "git",
        "write_file",
        "read",
        "run_python",
        "report",
        "read_state",
        "edit_file",
        "grep",
        "glob"
      ],
      "budget": {
        "tokens": 1000000,
        "wall_seconds": 600
      }
    }
  }
}
